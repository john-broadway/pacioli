# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.eggs/

# Virtualenvs
.venv/
venv/
env/
.venv-*/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
# Coverage REPORTS are build output — CI regenerates them every run and the floors that judge
# them live in scripts/coverage-floors.json (committed). A stale committed report is exactly the
# "audited the wrong subject" trap the gate exists to refuse.
*-cov.json
coverage.json

# Git worktrees (superpowers:using-git-worktrees)
.worktrees/

# OS / editor cruft
.DS_Store
*.swp
*~
.scratch/
